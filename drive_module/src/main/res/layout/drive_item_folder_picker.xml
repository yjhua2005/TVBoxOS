<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drive_button_dialog_main"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/drive_vs_20"
    android:paddingTop="@dimen/drive_vs_10"
    android:paddingRight="@dimen/drive_vs_20"
    android:paddingBottom="@dimen/drive_vs_10">

    <ImageView
        android:layout_width="@dimen/drive_vs_40"
        android:layout_height="@dimen/drive_vs_40"
        android:src="@drawable/drive_icon_folder" />

    <TextView
        android:id="@+id/tvFolderName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/drive_vs_15"
        android:layout_marginLeft="@dimen/drive_vs_15"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/drive_dialog_text_primary"
        android:textSize="@dimen/drive_ts_24" />

</LinearLayout>